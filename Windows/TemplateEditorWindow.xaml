<Window x:Class="MetroEditor.Windows.TemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="反编译模板编辑器" Height="680" Width="980" Topmost="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 说明栏 -->
        <Border Grid.Row="0" Background="#FFFDE7" BorderBrush="#FFE082" BorderThickness="1"
                CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#5D4037">
                <Run FontWeight="Bold" Text="模板语法："/>
                <Run Text="① 用 {{Key}} 声明占位符，反编译时由变量字典替换；"/>
                <Run Text="② 若某行所有占位符均为空值则整行删除（用于 CITY/DISABLE/FUTURE 等可选行）；"/>
                <Run Text="③ 占位符 Key 为字母/数字/下划线。修改保存后立即生效，下次反编译即采用新模板。"/>
            </TextBlock>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧模板列表 -->
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="模板列表" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#555"/>
                <TextBlock x:Name="DirText" DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="10"
                           Foreground="#888" Margin="0,0,0,6"/>
                <ListBox x:Name="TemplateList" SelectionChanged="TemplateList_SelectionChanged"/>
            </DockPanel>

            <!-- 右侧编辑器 -->
            <DockPanel Grid.Column="1">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock x:Name="CurrentTemplateText" FontWeight="SemiBold" VerticalAlignment="Center"
                               Text="（请选择模板）" Foreground="#333"/>
                    <Border Background="#E3F2FD" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="DirtyFlag" Text="未修改" FontSize="11" Foreground="#1565C0"/>
                    </Border>
                </StackPanel>
                <avalon:TextEditor x:Name="editor" FontFamily="Consolas" FontSize="13"
                                   ShowLineNumbers="True" IsReadOnly="False"
                                   WordWrap="False" HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Visible"/>
            </DockPanel>
        </Grid>

        <!-- 底部操作栏 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="重新加载" Click="Reload_Click" Width="100" Margin="0,0,8,0"/>
            <Button Content="保存" Click="Save_Click" Width="100" Margin="0,0,8,0"/>
            <Button Content="关闭" Click="Close_Click" Width="80"/>
        </StackPanel>
    </Grid>
</Window>
