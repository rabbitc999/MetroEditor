<Window x:Class="MetroEditor.Windows.TimeParameterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="时间参数编辑" Height="650" Width="1000" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- 状态中文选项 -->
        <x:Array x:Key="statusDisplayOptions" Type="sys:String">
            <sys:String>站内换乘</sys:String>
            <sys:String>出站换乘</sys:String>
            <sys:String>暂缓开通</sys:String>
        </x:Array>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 默认时间 -->
        <GroupBox Header="默认时间 (DEFAULT_TIME)" Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="站内换乘 (分钟):" Grid.Column="0" VerticalAlignment="Center" Margin="5,0"/>
                <TextBox x:Name="InStationTimeBox" Grid.Column="1" Margin="5" Text="3.0"/>
                <Label Content="出站换乘 (分钟):" Grid.Column="2" VerticalAlignment="Center" Margin="5,0"/>
                <TextBox x:Name="OutStationTimeBox" Grid.Column="3" Margin="5" Text="5.0"/>
                <Label Content="停站 (分钟):" Grid.Column="4" VerticalAlignment="Center" Margin="5,0"/>
                <TextBox x:Name="DwellTimeBox" Grid.Column="5" Margin="5" Text="0.5"/>
                <Label Content="进站平均时间:" Grid.Column="6" VerticalAlignment="Center" Margin="5,0"/>
                <TextBox x:Name="EntryTimeBox" Grid.Column="7" Margin="5" Text="0.5"/>
            </Grid>
        </GroupBox>

        <!-- 换乘规则列表 -->
        <GroupBox Header="自定义换乘 (TRANSFER)" Grid.Row="1" Grid.Column="0" Margin="0,0,5,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Button Content="添加" Click="AddTransfer_Click" Margin="0,0,5,0"/>
                    <Button Content="删除选中" Click="DeleteTransfer_Click" Margin="0,0,5,0"/>
                </StackPanel>
                <DataGrid x:Name="TransferGrid" Grid.Row="1" AutoGenerateColumns="False" 
                          CanUserAddRows="False" CanUserDeleteRows="False" Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="站名" Binding="{Binding Station}" Width="100"/>
                        <DataGridTextColumn Header="线路1" Binding="{Binding DisplayLine1}" Width="80"/>
                        <DataGridTextColumn Header="线路2" Binding="{Binding DisplayLine2}" Width="80"/>
                        <DataGridComboBoxColumn Header="状态" 
                                                SelectedItemBinding="{Binding StatusDisplay}" 
                                                ItemsSource="{StaticResource statusDisplayOptions}" 
                                                Width="90"/>
                        <DataGridTextColumn Header="时间(分钟)" Binding="{Binding TimeMin, StringFormat={}{0:F2}}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- 可拖动分割线 -->
        <GridSplitter Grid.Row="1" Grid.Column="1"
                  Width="5" 
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="LightGray"
                  ResizeBehavior="BasedOnAlignment" />
        
        <!-- 停站时间列表 -->
        <GroupBox Header="自定义停站时间 (DWELL_TIME)" Grid.Row="1" Grid.Column="2" Margin="5,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Button Content="添加" Click="AddDwellTime_Click" Margin="0,0,5,0"/>
                    <Button Content="删除选中" Click="DeleteDwellTime_Click" Margin="0,0,5,0"/>
                </StackPanel>
                <DataGrid x:Name="DwellTimeGrid" Grid.Row="1" AutoGenerateColumns="False" 
                          CanUserAddRows="False" CanUserDeleteRows="False" Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="站名" Binding="{Binding Station}" Width="100"/>
                        <DataGridComboBoxColumn Header="线路" 
                            SelectedItemBinding="{Binding DisplayLine, UpdateSourceTrigger=PropertyChanged}" 
                            ItemsSource="{Binding LineNames, RelativeSource={RelativeSource AncestorType=Window}}" 
                            Width="80"/>
                        <DataGridTextColumn Header="停站时间(分钟)" Binding="{Binding TimeMin, StringFormat={}{0:F2}}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- 预览 -->
        <GroupBox Header="代码预览" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="刷新预览" Click="RefreshPreview_Click" Grid.Row="0" HorizontalAlignment="Right" Margin="5"/>
                    <Button Content="复制到剪贴板" Click="CopyPreview_Click" Grid.Row="0" HorizontalAlignment="Right" Margin="5"/>
                </StackPanel>
                <TextBox x:Name="PreviewTextBox" Grid.Row="1" IsReadOnly="True" 
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" 
                         FontFamily="Consolas" FontSize="12" AcceptsReturn="True"/>
            </Grid>
        </GroupBox>

        <!-- 关闭 -->
        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="3" Grid.Row="3" HorizontalAlignment="Right" Margin="5">
            <Button Content="关闭" Click="Close_Click" Width="80"/>
        </StackPanel>
    </Grid>
</Window>