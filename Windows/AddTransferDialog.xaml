<Window x:Class="MetroEditor.Windows.AddTransferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加换乘规则" Height="260" Width="450" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="站名：" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <ComboBox x:Name="StationCombo" Grid.Row="0" Grid.Column="1" Margin="5" IsEditable="True" Text="请选择站点"/>

        <Label Content="线路1：" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <ComboBox x:Name="Line1Combo" Grid.Row="1" Grid.Column="1" Margin="5" 
            DisplayMemberPath="Display" SelectedValuePath="Id" IsEditable="True"/>
        <Label Content="线路2：" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <ComboBox x:Name="Line2Combo" Grid.Row="2" Grid.Column="1" Margin="5" 
            DisplayMemberPath="Display" SelectedValuePath="Id" IsEditable="True"/>

        <Label Content="状态：" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <ComboBox x:Name="StatusCombo" Grid.Row="3" Grid.Column="1" Margin="5" SelectedIndex="0">
            <ComboBoxItem Content="运营中" Tag="operating"/>
            <ComboBoxItem Content="出站换乘" Tag="out_station"/>
            <ComboBoxItem Content="待定" Tag="pending"/>
        </ComboBox>

        <Label Content="时间(分钟)：" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="TimeBox" Grid.Row="4" Grid.Column="1" Margin="5" Text="3.0"/>

        <StackPanel Orientation="Horizontal" Grid.Row="5" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="5">
            <Button Content="确定" Click="Ok_Click" Width="80" Margin="0,0,10,0"/>
            <Button Content="取消" Click="Cancel_Click" Width="80"/>
        </StackPanel>
    </Grid>
</Window>