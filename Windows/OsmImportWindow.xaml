<Window x:Class="MetroEditor.Windows.OsmImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="从OSM导入地铁数据" Height="600" Width="800" Topmost="True"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- OSM 文件 -->
        <Label Grid.Row="0" Grid.Column="0" Content="OSM JSON 文件：" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="OsmFilePathTextBox" Grid.Row="0" Grid.Column="1" Margin="5" VerticalAlignment="Center"/>
        <Button Grid.Row="0" Grid.Column="2" Content="浏览..." Click="BrowseOsmFile_Click" Margin="5" Width="80"/>

        <!-- 配置文件 -->
        <Label Grid.Row="1" Grid.Column="0" Content="配置文件 (可选):" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="ConfigFilePathTextBox" Grid.Row="1" Grid.Column="1" Margin="5" VerticalAlignment="Center"/>
        <Button Grid.Row="1" Grid.Column="2" Content="浏览..." Click="BrowseConfigFile_Click" Margin="5" Width="80"/>

        <!-- 主城市 -->
        <Label Grid.Row="2" Grid.Column="0" Content="主城市:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="KeyCityTextBox" Grid.Row="2" Grid.Column="1" Margin="5" VerticalAlignment="Center" Text="广州"/>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <Button Content="提取并生成" Click="ExtractButton_Click" Width="120" Margin="0,0,10,0" IsDefault="True"/>
            <Button Content="保存为 .metro" Click="SaveButton_Click" Width="120" Margin="0,0,10,0"/>
            <Button Content="关闭" Click="CloseButton_Click" Width="80"/>
        </StackPanel>

        <!-- 进度/状态 -->
        <TextBlock x:Name="StatusTextBlock" Grid.Row="4" Grid.ColumnSpan="3" Margin="5" Foreground="Blue"/>

        <!-- 预览 -->
        <GroupBox Header="生成的 .metro 预览" Grid.Row="5" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <TextBox x:Name="PreviewTextBox" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                     IsReadOnly="True" AcceptsReturn="True"/>
        </GroupBox>
    </Grid>
</Window>