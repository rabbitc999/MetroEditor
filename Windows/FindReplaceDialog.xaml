<Window x:Class="MetroEditor.Windows.FindReplaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="查找与替换" Height="180" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True">
    <Window.Resources>
        <Style TargetType="Button" x:Key="DialogButton">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 查找 -->
        <Label Grid.Row="0" Grid.Column="0" Content="查找:" VerticalAlignment="Center"/>
        <TextBox x:Name="FindTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" KeyDown="FindTextBox_KeyDown"/>

        <!-- 替换 -->
        <Label Grid.Row="1" Grid.Column="0" Content="替换为:" VerticalAlignment="Center"/>
        <TextBox x:Name="ReplaceTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"/>

        <!-- 选项 -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,4">
            <CheckBox x:Name="CaseSensitiveCheckBox" Content="区分大小写" Margin="0,0,15,0"/>
            <CheckBox x:Name="WholeWordCheckBox" Content="全字匹配"/>
        </StackPanel>

        <!-- 状态信息 -->
        <TextBlock x:Name="StatusTextBlock" Grid.Row="3" Grid.ColumnSpan="2" Foreground="Gray" FontSize="12" Margin="0,0,0,6"/>

        <!-- 按钮 -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="查找下一个" Click="FindNext_Click" Style="{StaticResource DialogButton}" IsDefault="True"/>
            <Button Content="替换" Click="Replace_Click" Style="{StaticResource DialogButton}"/>
            <Button Content="替换全部" Click="ReplaceAll_Click" Style="{StaticResource DialogButton}"/>
            <Button Content="关闭" Click="Close_Click" Style="{StaticResource DialogButton}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>