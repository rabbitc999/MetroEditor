<Window x:Class="MetroEditor.Windows.NetworkStatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="路网统计" Height="720" Width="1000" Topmost="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 汇总卡片 -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
            <Border Background="#F5F5F5" CornerRadius="6" Padding="14,8" Margin="0,0,10,6">
                <StackPanel>
                    <TextBlock Text="线路总数" Foreground="#888" FontSize="11"/>
                    <TextBlock x:Name="LineCountText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#1976D2"/>
                </StackPanel>
            </Border>
            <Border Background="#F5F5F5" CornerRadius="6" Padding="14,8" Margin="0,0,10,6">
                <StackPanel>
                    <TextBlock Text="车站总数" Foreground="#888" FontSize="11"/>
                    <TextBlock x:Name="StationCountText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#1976D2"/>
                </StackPanel>
            </Border>
            <Border Background="#F5F5F5" CornerRadius="6" Padding="14,8" Margin="0,0,10,6">
                <StackPanel>
                    <TextBlock Text="换乘站" Foreground="#888" FontSize="11"/>
                    <TextBlock x:Name="TransferCountText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#FF9800"/>
                </StackPanel>
            </Border>
            <Border Background="#F5F5F5" CornerRadius="6" Padding="14,8" Margin="0,0,10,6">
                <StackPanel>
                    <TextBlock Text="总里程 (km)" Foreground="#888" FontSize="11"/>
                    <TextBlock x:Name="TotalLengthText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#4CAF50"/>
                </StackPanel>
            </Border>
            <Border Background="#F5F5F5" CornerRadius="6" Padding="14,8" Margin="0,0,10,6">
                <StackPanel>
                    <TextBlock Text="暂缓/未来站" Foreground="#888" FontSize="11"/>
                    <TextBlock x:Name="FutureCountText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#E64A19"/>
                </StackPanel>
            </Border>
            <Border Background="#F5F5F5" CornerRadius="6" Padding="14,8" Margin="0,0,10,6">
                <StackPanel>
                    <TextBlock Text="环线数" Foreground="#888" FontSize="11"/>
                    <TextBlock x:Name="LoopCountText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#9C27B0"/>
                </StackPanel>
            </Border>
            <Border Background="#F5F5F5" CornerRadius="6" Padding="14,8" Margin="0,0,10,6">
                <StackPanel>
                    <TextBlock Text="快车线路" Foreground="#888" FontSize="11"/>
                    <TextBlock x:Name="ExpressCountText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#00897B"/>
                </StackPanel>
            </Border>
            <Border Background="#F5F5F5" CornerRadius="6" Padding="14,8" Margin="0,0,10,6">
                <StackPanel>
                    <TextBlock Text="运营公司" Foreground="#888" FontSize="11"/>
                    <TextBlock x:Name="OperatorCountText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#607D8B"/>
                </StackPanel>
            </Border>
            <Border Background="#F5F5F5" CornerRadius="6" Padding="14,8" Margin="0,0,10,6">
                <StackPanel>
                    <TextBlock Text="区域数" Foreground="#888" FontSize="11"/>
                    <TextBlock x:Name="ZoneCountText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#795548"/>
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- 线路明细表 -->
        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="线路明细" FontWeight="SemiBold" Margin="6,4" Foreground="#555"/>
                <DataGrid x:Name="LineGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="线路ID" Binding="{Binding LineId}" Width="80"/>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="120"/>
                        <DataGridTextColumn Header="城市" Binding="{Binding City}" Width="70"/>
                        <DataGridTextColumn Header="车站数" Binding="{Binding StationCount}" Width="70"/>
                        <DataGridTextColumn Header="里程(km)" Binding="{Binding Length}" Width="90"/>
                        <DataGridTextColumn Header="里程占比" Binding="{Binding LengthRatio}" Width="80"/>
                        <DataGridTextColumn Header="属性" Binding="{Binding Tags}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- 各线路车站数柱状图 -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="各线路主线车站数" FontWeight="SemiBold"
                           Margin="6,4" Foreground="#555"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="StationChart" Margin="6,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                               FontSize="11" VerticalAlignment="Center" Foreground="#444"/>
                                    <Border Grid.Column="1" Height="16" HorizontalAlignment="Left"
                                            Width="{Binding BarWidth}" Background="{Binding Brush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Count}"
                                               FontSize="11" VerticalAlignment="Center" Foreground="#666"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
