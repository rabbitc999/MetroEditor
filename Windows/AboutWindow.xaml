<Window x:Class="MetroEditor.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 Metro 线路编辑器" Height="300" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="/ic_launcher-playstore.png">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Image Grid.Row="0" Source="/ic_launcher-playstore.png" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" Text="Metro 线路编辑器" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Grid.Row="2" Text="版本 1.0" FontSize="14" HorizontalAlignment="Center" Margin="0,5"/>
        <TextBlock Grid.Row="3" Text="Power By 2026 诚岩电子" FontSize="12" HorizontalAlignment="Center" Margin="0,5" Foreground="Gray"/>
        <TextBlock Grid.Row="4" HorizontalAlignment="Center" Margin="0,5">
            <Hyperlink NavigateUri="https://gitee.com/embed2026/subway_work_score" RequestNavigate="Hyperlink_RequestNavigate">
                开源地址
            </Hyperlink>
        </TextBlock>
        <TextBlock Grid.Row="5" Text="使用C# WPF界面编写" FontSize="12" HorizontalAlignment="Center" Foreground="Gray" TextWrapping="Wrap" TextAlignment="Center"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="退出关于界面" IsDefault="True" Width="100" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>