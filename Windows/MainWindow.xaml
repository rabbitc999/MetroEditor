<Window x:Class="MetroEditor.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:MetroEditor"
        xmlns:controls="clr-namespace:MetroEditor.Windows.Controls"
        Title="地铁线路编辑器" Height="800" Width="1199"
        WindowStartupLocation="CenterScreen" Icon="/ic_launcher-playstore.png"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop"
        Closed="Window_Closed">
    <Window.Resources>
        <!-- 自定义命令 -->
        <RoutedUICommand x:Key="CompileCommand" Text="编译"/>
        <RoutedUICommand x:Key="DecompileCommand" Text="反编译"/>
        <RoutedUICommand x:Key="OpenStationManagerCommand" Text="站点管理"/>
        <RoutedUICommand x:Key="GenerateLineCommand" Text="生成线路"/>
        <RoutedUICommand x:Key="GenerateDirectionCommand" Text="生成方向"/>
        <RoutedUICommand x:Key="MapEditorCommand" Text="站点拖拽微调"/>
        <RoutedUICommand x:Key="SettingsCommand" Text="选项"/>
        <RoutedUICommand x:Key="AboutCommand" Text="关于"/>
        <!-- 视图菜单命令 -->
        <RoutedUICommand x:Key="ToggleWordWrapCommand" Text="自动换行"/>
        <RoutedUICommand x:Key="ZoomInCommand" Text="增大字体"/>
        <RoutedUICommand x:Key="ZoomOutCommand" Text="减小字体"/>
        <RoutedUICommand x:Key="ToggleLineNumbersCommand" Text="显示行号"/>
        <RoutedUICommand x:Key="TogglePreviewCommand" Text="显示预览面板"/>
    </Window.Resources>
    <Window.CommandBindings>
        <!-- 标准 ApplicationCommands -->
        <CommandBinding Command="ApplicationCommands.New" Executed="NewFile_Click"/>
        <CommandBinding Command="ApplicationCommands.Open" Executed="OpenFile_Click"/>
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveFile_Click"/>
        <CommandBinding Command="ApplicationCommands.Undo" Executed="Undo_Click"/>
        <CommandBinding Command="ApplicationCommands.Redo" Executed="Redo_Click"/>
        <CommandBinding Command="ApplicationCommands.Cut" Executed="Cut_Click"/>
        <CommandBinding Command="ApplicationCommands.Copy" Executed="Copy_Click"/>
        <CommandBinding Command="ApplicationCommands.Paste" Executed="Paste_Click"/>
        <CommandBinding Command="ApplicationCommands.SelectAll" Executed="SelectAll_Click"/>
        <CommandBinding Command="ApplicationCommands.Find" Executed="Find_Click"/>

        <!-- 自定义命令 -->
        <CommandBinding Command="{StaticResource CompileCommand}" Executed="Compile_Click"/>
        <CommandBinding Command="{StaticResource DecompileCommand}" Executed="Decompile_Click"/>
        <CommandBinding Command="{StaticResource OpenStationManagerCommand}" Executed="OpenStationManager_Click"/>
        <CommandBinding Command="{StaticResource GenerateLineCommand}" Executed="GenerateLine_Click"/>
        <CommandBinding Command="{StaticResource GenerateDirectionCommand}" Executed="GenerateDirection_Click"/>
        <CommandBinding Command="{StaticResource MapEditorCommand}" Executed="MapEditor_Click"/>
        <CommandBinding Command="{StaticResource SettingsCommand}" Executed="Settings_Click"/>
        <CommandBinding Command="{StaticResource AboutCommand}" Executed="About_Click"/>
        <CommandBinding Command="{StaticResource ToggleWordWrapCommand}" Executed="ToggleWordWrap_Click"/>
        <CommandBinding Command="{StaticResource ToggleLineNumbersCommand}" Executed="ToggleLineNumbers_Click"/>

        <!-- 视图命令（带参数或 toggle） -->
        <CommandBinding Command="{StaticResource ZoomInCommand}" Executed="ZoomIn_Click"/>
        <CommandBinding Command="{StaticResource ZoomOutCommand}" Executed="ZoomOut_Click"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <!-- 标准快捷键（ApplicationCommands 已自带，但可显式绑定） -->
        <KeyBinding Key="N" Modifiers="Control" Command="ApplicationCommands.New"/>
        <KeyBinding Key="O" Modifiers="Control" Command="ApplicationCommands.Open"/>
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="ApplicationCommands.Undo"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="ApplicationCommands.Redo"/>
        <KeyBinding Key="X" Modifiers="Control" Command="ApplicationCommands.Cut"/>
        <KeyBinding Key="C" Modifiers="Control" Command="ApplicationCommands.Copy"/>
        <KeyBinding Key="V" Modifiers="Control" Command="ApplicationCommands.Paste"/>
        <KeyBinding Key="A" Modifiers="Control" Command="ApplicationCommands.SelectAll"/>
        <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find"/>
        <KeyBinding Key="H" Modifiers="Control" Command="ApplicationCommands.Replace"/>

        <!-- 自定义快捷键 -->
        <KeyBinding Key="F7" Modifiers="Alt" Command="{StaticResource CompileCommand}"/>
        <KeyBinding Key="F8" Modifiers="Alt" Command="{StaticResource DecompileCommand}"/>
        <KeyBinding Key="F1" Modifiers="Alt" Command="{StaticResource OpenStationManagerCommand}"/>
        <KeyBinding Key="F4" Modifiers="Alt" Command="{StaticResource GenerateLineCommand}"/>
        <KeyBinding Key="F5" Modifiers="Alt" Command="{StaticResource GenerateDirectionCommand}"/>
        <KeyBinding Key="F6" Modifiers="Alt" Command="{StaticResource MapEditorCommand}"/>

        <!-- 视图快捷键（使用 Ctrl+Plus 等可能有冲突，可用其他组合） -->
        <KeyBinding Key="Add" Modifiers="Alt" Command="{StaticResource ZoomInCommand}"/>
        <KeyBinding Key="Subtract" Modifiers="Alt" Command="{StaticResource ZoomOutCommand}"/>
    </Window.InputBindings>

    <Grid Cursor="">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.6*" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="0.4*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 菜单 -->
        <Menu Grid.Row="0" Grid.ColumnSpan="3">
            <MenuItem Header="_文件">
                <MenuItem Header="_新建" Command="ApplicationCommands.New"/>
                <MenuItem Header="_打开..." Command="ApplicationCommands.Open"/>
                <MenuItem x:Name="mnuRecentFiles" Header="最近文件" />
                <Separator/>
                <MenuItem Header="_保存" Command="ApplicationCommands.Save"/>
                <MenuItem Header="另存为..." Click="SaveAsFile_Click"/>
                <Separator/>
                <MenuItem Header="退出" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_编辑">
                <MenuItem Header="撤销" Command="ApplicationCommands.Undo"/>
                <MenuItem Header="重做" Command="ApplicationCommands.Redo"/>
                <Separator/>
                <MenuItem Header="剪切" Command="ApplicationCommands.Cut"/>
                <MenuItem Header="复制" Command="ApplicationCommands.Copy"/>
                <MenuItem Header="粘贴" Command="ApplicationCommands.Paste"/>
                <Separator/>
                <MenuItem Header="查找/替换" Command="ApplicationCommands.Find"/>
                <MenuItem Header="全选" Command="ApplicationCommands.SelectAll"/>
            </MenuItem>
            <MenuItem Header="_视图">
                <MenuItem x:Name="mnuWordWrap" Header="自动换行" Command="{StaticResource ToggleWordWrapCommand}" IsCheckable="True"/>
                <MenuItem x:Name="mnuLineNumbers" Header="显示行号" Command="{StaticResource ToggleLineNumbersCommand}" IsCheckable="True" IsChecked="True"/>
                <Separator/>
                <MenuItem Header="增大字体" Command="{StaticResource ZoomInCommand}"/>
                <MenuItem Header="减小字体" Command="{StaticResource ZoomOutCommand}"/>
                <Separator/>
                <MenuItem Header="显示预览面板" IsCheckable="True" IsChecked="True" Checked="ShowPreview_Checked" Unchecked="ShowPreview_Unchecked"/>
            </MenuItem>
            <MenuItem Header="_数据">
                <MenuItem Header="_基础数据">
                    <MenuItem Header="程序信息" Click="ProgramInfo_Click"/>
                    <MenuItem Header="站点管理" Command="{StaticResource OpenStationManagerCommand}"/>
                    <MenuItem Header="生成线路" Command="{StaticResource GenerateLineCommand}"/>
                    <MenuItem Header="生成方向" Command="{StaticResource GenerateDirectionCommand}"/>
                    <MenuItem Header="站点拖拽微调" Command="{StaticResource MapEditorCommand}"/>
                    <Separator/>
                    <MenuItem Header="区域管理" Click="ZoneManager_Click"/>
                    <MenuItem Header="运营公司" Click="OperatorManager_Click"/>
                </MenuItem>
                <MenuItem Header="_运行参数">
                    <MenuItem Header="时间参数设置" Click="TimeParameterEditor_Click"/>
                    <MenuItem Header="编辑票价规则" Click="FareSettings_Click"/>
                    <MenuItem Header="批量设置暂缓站点" Click="BatchPending_Click"/>
                </MenuItem>
                <MenuItem Header="_统计">
                    <MenuItem Header="路网统计" Click="NetworkStatistics_Click"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_分析">
                <MenuItem Header="通勤分析" Click="CommuteAnalysis_Click"/>
                <MenuItem Header="城市详情" Click="CityInfo_Click"/>
                <MenuItem Header="线路详情" Click="LineDetail_Click"/>
                <Separator/>
                <MenuItem Header="路线测试" Click="OpenRouteDetailWindow_Click"/>
                <MenuItem Header="区间图像计算与绘制" Click="OpenIntervalTimeCalculatorWindow_Click"/>
            </MenuItem>
            <MenuItem Header="_工具">
                <MenuItem Header="编译" Command="{StaticResource CompileCommand}"/>
                <MenuItem Header="反编译" Command="{StaticResource DecompileCommand}"/>
                <MenuItem Header="导出站点 CSV" Click="ExportStationsCsv_Click"/>
                <Separator/>
                <MenuItem Header="批量编译..." Click="BatchCompile_Click"/>
                <MenuItem Header="批量反编译..." Click="BatchDecompile_Click"/>
                <Separator/>
                <MenuItem Header="模板编辑器..." Click="TemplateEditor_Click"/>
                <MenuItem Header="从OSM导入..." Click="OsmImport_Click"/>
                <MenuItem Header="迁移到新语法">
                    <MenuItem Header="迁移当前文件..." Click="MigrateCurrentFile_Click"/>
                    <MenuItem Header="批量迁移目录..." Click="MigrateDirectory_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="选项" Command="{StaticResource SettingsCommand}"/>
            </MenuItem>
            <MenuItem Header="_设备同步">
                <MenuItem x:Name="mnuSyncStartServer" Header="启动同步服务" Click="SyncStartServer_Click"/>
                <MenuItem x:Name="mnuSyncStopServer" Header="停止同步服务" Click="SyncStopServer_Click" IsEnabled="False"/>
                <MenuItem x:Name="mnuSyncConfig" Header="同步设置..." Click="SyncConfig_Click"/>
                <Separator/>
                <MenuItem x:Name="mnuSyncSearch" Header="自动搜索设备..." Click="SyncSearchDevices_Click" IsEnabled="False"/>
                <Separator/>
                <MenuItem x:Name="mnuSyncPush" Header="推送当前地图到设备" Click="SyncPush_Click" IsEnabled="False"/>
                <MenuItem x:Name="mnuSyncExportRecords" Header="导出手机记录..." Click="SyncExportRecords_Click" IsEnabled="False"/>
                <MenuItem x:Name="mnuSyncPushRecords" Header="推送记录到设备..." Click="SyncPushRecords_Click" IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="_帮助">
                <MenuItem Header="关于" Command="{StaticResource AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- 工具栏：仅保留高频操作 -->
        <ToolBar Grid.Row="1" Grid.ColumnSpan="3">
            <Button Click="NewFile_Click" ToolTip="新建文件 (Ctrl+N)" Padding="6,3" Margin="1,0">
                <StackPanel Orientation="Horizontal">
                    <Path Fill="#333" Width="16" Height="16" Stretch="Uniform" Data="M4,2 L4,14 L14,14 L14,6 L10,2 Z M10,2 L10,6 L14,6"/>
                    <TextBlock Text="新建" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Click="OpenFile_Click" ToolTip="打开文件 (Ctrl+O)" Padding="6,3" Margin="1,0">
                <StackPanel Orientation="Horizontal">
                    <Path Fill="#333" Width="16" Height="16" Stretch="Uniform" Data="M8,2 L3,2 C2.4,2 2,2.4 2,3 L2,13 C2,13.6 2.4,14 3,14 L13,14 C13.6,14 14,13.6 14,13 L14,5 L10,1 L9,1 Z M3,11 L4,8 L6,10 L9,7 L11,11 Z"/>
                    <TextBlock Text="打开" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Click="SaveFile_Click" ToolTip="保存 (Ctrl+S)" Padding="6,3" Margin="1,0">
                <StackPanel Orientation="Horizontal">
                    <Path Fill="#333" Width="16" Height="16" Stretch="Uniform" Data="M17,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V7L17,3z M12,19c-1.7,0-3-1.3-3-3s1.3-3,3-3s3,1.3,3,3S13.7,19,12,19z M15,9H6V5h9V9z"/>
                    <TextBlock Text="保存" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Click="Undo_Click" ToolTip="撤销 (Ctrl+Z)" Padding="6,3" Margin="1,0">
                <StackPanel Orientation="Horizontal">
                    <Path Fill="#333" Width="16" Height="16" Stretch="Uniform" Data="M12.5,8c-2.65,0-5.05,1-6.9,2.6L2,7v9h9l-3.6-3.6C8.8,11.2,10.55,10.5,12.5,10.5c3.55,0,6.55,2.05,7.9,5.1l1.6-0.9C20.3,10.9,16.7,8,12.5,8z"/>
                    <TextBlock Text="撤销" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Click="Redo_Click" ToolTip="重做 (Ctrl+Y)" Padding="6,3" Margin="1,0">
                <StackPanel Orientation="Horizontal">
                    <Path Fill="#333" Width="16" Height="16" Stretch="Uniform" Data="M18.4,10.6C16.55,9,14.15,8,11.5,8c-4.2,0-7.8,2.9-9.5,6.7l1.6,0.9C4.95,12.55,7.95,10.5,11.5,10.5c1.95,0,3.7,0.7,5.1,1.9L13,16h9V7L18.4,10.6z"/>
                    <TextBlock Text="重做" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Click="Cut_Click" ToolTip="剪切 (Ctrl+X)" Padding="6,3" Margin="1,0">
                <StackPanel Orientation="Horizontal">
                    <Path Fill="#333" Width="16" Height="16" Stretch="Uniform" Data="M9.64,7.64c0.23,-0.5 0.36,-1.05 0.36,-1.64 0,-2.21 -1.79,-4 -4,-4s-4,1.79 -4,4 1.79,4 4,4c0.59,0 1.14,-0.13 1.64,-0.36L10,12l-2.36,2.36C7.14,14.13 6.59,14 6,14c-2.21,0 -4,1.79 -4,4s1.79,4 4,4 4,-1.79 4,-4c0,-0.59 -0.13,-1.14 -0.36,-1.64L12,14l7,7h3v-1L9.64,7.64zM6,8c-1.1,0 -2,-0.9 -2,-2s0.9,-2 2,-2 2,0.9 2,2 -0.9,2 -2,2zM6,20c-1.1,0 -2,-0.9 -2,-2s0.9,-2 2,-2 2,0.9 2,2 -0.9,2 -2,2zM19,3l-6,6 2,2 7,-7V3h-3z"/>
                    <TextBlock Text="剪切" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Click="Copy_Click" ToolTip="复制 (Ctrl+C)" Padding="6,3" Margin="1,0">
                <StackPanel Orientation="Horizontal">
                    <Path Fill="#333" Width="16" Height="16" Stretch="Uniform" Data="M16,1H4C2.9,1,2,1.9,2,3v14h2V3h12V1z M19,5H8C6.9,5,6,5.9,6,7v14c0,1.1,0.9,2,2,2h11c1.1,0,2-0.9,2-2V7C21,5.9,20.1,5,19,5z M19,21H8V7h11V21z"/>
                    <TextBlock Text="复制" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Click="Paste_Click" ToolTip="粘贴 (Ctrl+V)" Padding="6,3" Margin="1,0">
                <StackPanel Orientation="Horizontal">
                    <Path Fill="#333" Width="16" Height="16" Stretch="Uniform" Data="M19,2h-4.18C14.4,0.84,13.3,0,12,0S9.6,0.84,9.18,2H5C3.9,2,3,2.9,3,4v16c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V4C21,2.9,20.1,2,19,2z M12,2c0.55,0,1,0.45,1,1s-0.45,1-1,1s-1-0.45-1-1S11.45,2,12,2z M19,20H5V4h2v3h10V4h2V20z"/>
                    <TextBlock Text="粘贴" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Click="Find_Click" ToolTip="查找/替换 (Ctrl+F)" Padding="6,3" Margin="1,0">
                <StackPanel Orientation="Horizontal">
                    <Path Fill="#333" Width="16" Height="16" Stretch="Uniform" Data="M15.5,14h-0.79l-0.28,-0.27C15.41,12.59 16,11.11 16,9.5 16,5.91 13.09,3 9.5,3S3,5.91 3,9.5 5.91,16 9.5,16c1.61,0 3.09,-0.59 4.23,-1.57l0.27,0.28v0.79l5,5 1.5,-1.5L15.5,14zM9.5,14C7.01,14 5,11.99 5,9.5S7.01,5 9.5,5 14,7.01 14,9.5 11.99,14 9.5,14z"/>
                    <TextBlock Text="查找/替换" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Click="Compile_Click" ToolTip="编译当前文件 (Alt+F7)" Padding="6,3" Margin="1,0">
                <StackPanel Orientation="Horizontal">
                    <Path Fill="#333" Width="16" Height="16" Stretch="Uniform" Data="M8,5v14l11-7L8,5z"/>
                    <TextBlock Text="编译" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Click="Decompile_Click" ToolTip="反编译当前文件 (Alt+F8)" Padding="6,3" Margin="1,0">
                <StackPanel Orientation="Horizontal">
                    <Path Fill="#333" Width="16" Height="16" Stretch="Uniform" Data="M16,5v14l-11-7L16,5z"/>
                    <TextBlock Text="反编译" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Click="ExportStationsCsv_Click" ToolTip="导出当前站点列表为 CSV 文件" Padding="6,3" Margin="1,0">
                <StackPanel Orientation="Horizontal">
                    <Path Fill="#333" Width="16" Height="16" Stretch="Uniform" Data="M14,2H6C4.9,2,4,2.9,4,4v16c0,1.1,0.9,2,2,2h12c1.1,0,2-0.9,2-2V8L14,2z M12,18l-4-4h2.5v-3h3v3H16L12,18z M13,9V3.5L18.5,9H13z"/>
                    <TextBlock Text="导出站点CSV" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Click="OpenStationManager_Click" ToolTip="站点管理 (Alt+F1)" Padding="6,3" Margin="1,0">
                <StackPanel Orientation="Horizontal">
                    <Path Fill="#333" Width="16" Height="16" Stretch="Uniform" Data="M12,2C8.13,2,5,5.13,5,9c0,5.25,7,13,7,13s7-7.75,7-13C19,5.13,15.87,2,12,2z M12,11.5c-1.38,0-2.5-1.12-2.5-2.5S10.62,6.5,12,6.5s2.5,1.12,2.5,2.5S13.38,11.5,12,11.5z"/>
                    <TextBlock Text="站点管理" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Click="OpenRouteDetailWindow_Click" ToolTip="独立路线查询与详情窗口" Padding="6,3" Margin="1,0">
                <StackPanel Orientation="Horizontal">
                    <Path Fill="#333" Width="16" Height="16" Stretch="Uniform" Data="M4,12 L8,12 L10,8 L14,16 L16,12 L20,12"/>
                    <TextBlock Text="路线测试" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
        </ToolBar>

        <!-- 编辑器区域 -->
        <controls:DocumentWorkspace x:Name="documentWorkspace" Grid.Row="2" Grid.Column="0" />

        <!-- 预览面板 (右列，行2) -->
        <Border Grid.Row="2" Grid.Column="2" Grid.RowSpan="2" Width="Auto" Background="#F0F0F0" BorderBrush="#CCC" BorderThickness="1,0,0,0" x:Name="previewPanel">
            <TabControl>
                <TabItem Header="线网预览">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="线路预览" FontWeight="Bold" Margin="5"/>
                        <controls:MetroMapControl x:Name="mapControl" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" />
                    </Grid>
                </TabItem>

                <TabItem Header="代码参考">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <GroupBox Grid.Row="0" Header="关键字栏" Margin="0,0,0,5" Padding="5">
                            <controls:KeywordPanel x:Name="keywordPanel" KeywordClicked="KeywordPanel_KeywordClicked" />
                        </GroupBox>
                        <GroupBox Grid.Row="1" Header="语法参考" Margin="0,5,0,0" Padding="5">
                            <controls:SyntaxReferencePanel x:Name="syntaxRefPanel" ItemDoubleClicked="SyntaxRefPanel_ItemDoubleClicked" />
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="站台列表">
                    <controls:StationListPanel x:Name="stationListPanel" 
                               ParsedData="{Binding ElementName=documentWorkspace, Path=CurrentTab.ParsedData}" />
                </TabItem>

                <TabItem Header="方向列表">
                    <controls:DirectionListPanel x:Name="directionListPanel" 
                                 ParsedData="{Binding ElementName=documentWorkspace, Path=CurrentTab.ParsedData}" />
                </TabItem>

                <TabItem Header="线路预览">
                    <controls:LineListPanel x:Name="lineListPanel" 
                            ParsedData="{Binding ElementName=documentWorkspace, Path=CurrentTab.ParsedData}" />
                </TabItem>

                <TabItem Header="票价参数">
                    <controls:FareParametersPanel x:Name="fareParametersPanel" 
                                  ParsedData="{Binding ElementName=documentWorkspace, Path=CurrentTab.ParsedData}" />
                </TabItem>

                <TabItem Header="时间参数">
                    <controls:TimeParametersPanel x:Name="timeParametersPanel" 
                                  ParsedData="{Binding ElementName=documentWorkspace, Path=CurrentTab.ParsedData}" />
                </TabItem>

                <TabItem Header="系统信息">
                    <controls:SystemInfoPanel x:Name="systemInfo"
                                              ParsedData="{Binding ElementName=documentWorkspace, Path=CurrentTab.ParsedData}" />
                </TabItem>
            </TabControl>
        </Border>

        <!-- 可拖动分割线 -->
        <GridSplitter Grid.Row="2" Grid.Column="1" Grid.RowSpan="2"
                  Width="5" 
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="LightGray"
                  ResizeBehavior="BasedOnAlignment" />

        <!-- 状态栏 (左列，行4) -->
        <StatusBar Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
            <StatusBarItem>
                <TextBlock x:Name="statusInfo" Text="就绪" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="cursorStatus" Text="行: 1, 列: 1" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="syncIp" Text="" Foreground="#555" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="syncStatus" Text="同步: 未启动" Foreground="#999" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>