<Window x:Class="MetroEditor.Windows.BatchPendingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量设置暂缓站点" Height="500" Width="600" Topmost="True"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 线路选择 -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <Label Content="选择线路：" VerticalAlignment="Center" Margin="5,0"/>
            <ComboBox x:Name="LineCombo" Width="200" Margin="5,0" 
                      DisplayMemberPath="Display" SelectedValuePath="Id"/>
        </StackPanel>

        <!-- 站点列表（多选） -->
        <GroupBox Header="选择站点" Grid.Row="1" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="SearchBox" Grid.Row="0" Margin="5" TextChanged="SearchBox_TextChanged"
                         ToolTip="输入关键字筛选站点"/>
                <ListBox x:Name="StationListBox" Grid.Row="1" SelectionMode="Extended" Margin="5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </GroupBox>

        <!-- 预览 -->
        <GroupBox Header="生成代码预览" Grid.Row="2" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Right" Margin="5">
                    <Button Content="生成代码" Click="GenerateCode_Click" Margin="0,0,5,0"/>
                    <Button Content="复制到代码" Click="CopyPreview_Click"/>
                </StackPanel>
                <TextBox x:Name="PreviewTextBox" Grid.Row="1" IsReadOnly="True"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12" AcceptsReturn="True"/>
            </Grid>
        </GroupBox>

        <!-- 按钮 -->
        <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Right" Margin="5">
            <Button Content="关闭" Click="Close_Click" Width="80"/>
        </StackPanel>
    </Grid>
</Window>