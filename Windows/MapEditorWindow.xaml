<Window x:Class="MetroEditor.Windows.MapEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MetroEditor.Windows.Controls"
        Title="地图编辑器" Height="640" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="640" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 使用 MetroMapControl，开启编辑模式 -->
        <controls:MetroMapControl x:Name="mapControl" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" IsEditMode="True" />

        <!-- 右侧预览 -->
        <Border Grid.Row="0" Grid.Column="1" BorderThickness="1,0,0,0" Margin="0,0,0,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="STATION_DEFINE 预览" FontWeight="Bold" Margin="10,5" Grid.Row="0" />
                <TextBox x:Name="PreviewTextBox" Grid.Row="1" 
                         TextWrapping="NoWrap" 
                         VerticalScrollBarVisibility="Auto" 
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" 
                         FontSize="12" 
                         Padding="5" 
                         IsReadOnly="False" 
                         Background="White"
                         Margin="10" />
            </Grid>
        </Border>

        <!-- 底部工具栏 -->
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
            <Button Content="刷新预览" Click="RefreshPreview_Click" Margin="0,0,10,0" />
            <Button Content="复制代码" Click="Copy_Click" Margin="0,0,10,0" />
            <Button Content="关闭" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>