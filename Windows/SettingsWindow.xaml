<Window x:Class="MetroEditor.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="400" Width="370" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Icon="/ic_launcher-playstore.png" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 字体大小 -->
        <Label Grid.Row="0" Grid.Column="0" Content="字体大小:" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Slider x:Name="FontSizeSlider" Minimum="8" Maximum="30" Value="14" Width="160" TickFrequency="1" IsSnapToTickEnabled="True"/>
            <TextBlock x:Name="FontSizeDisplay" Text="14" Margin="10,0,0,0" Width="30"/>
        </StackPanel>

        <!-- 字体名称 -->
        <Label Grid.Row="2" Grid.Column="0" Content="字体:" VerticalAlignment="Center"/>
        <ComboBox x:Name="FontFamilyComboBox" Grid.Row="2" Grid.Column="1" IsEditable="False" 
                  VerticalAlignment="Center" Height="25"/>

        <!-- API Key -->
        <Label Grid.Row="4" Grid.Column="0" Content="高德API Key:" VerticalAlignment="Center"/>
        <PasswordBox x:Name="ApiKeyPasswordBox" Grid.Row="4" Grid.Column="1" Height="25" VerticalAlignment="Center"/>
        <!-- 权重设置 -->
        <GroupBox Header="路径搜索权重" Grid.Row="6" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 长度权重 -->
                <Label Grid.Row="0" Grid.Column="0" Content="长度权重:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider x:Name="LengthWeightSlider" Minimum="0" Maximum="2" Value="0.02" TickFrequency="0.01" Width="160"/>
                    <TextBlock x:Name="LengthWeightDisplay" Text="0.02" Margin="10,0,0,0" Width="40"/>
                </StackPanel>

                <!-- 换乘权重 -->
                <Label Grid.Row="1" Grid.Column="0" Content="换乘权重:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider x:Name="TransferWeightSlider" Minimum="0" Maximum="10" Value="0.5" TickFrequency="0.1" Width="160"/>
                    <TextBlock x:Name="TransferWeightDisplay" Text="0.5" Margin="10,0,0,0" Width="40"/>
                </StackPanel>

                <!-- 票价权重 -->
                <Label Grid.Row="2" Grid.Column="0" Content="票价权重:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider x:Name="MoneyWeightSlider" Minimum="0" Maximum="5" Value="1.0" TickFrequency="0.1" Width="160"/>
                    <TextBlock x:Name="MoneyWeightDisplay" Text="1.0" Margin="10,0,0,0" Width="40"/>
                </StackPanel>

                <!-- 时间权重 -->
                <Label Grid.Row="3" Grid.Column="0" Content="时间权重:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider x:Name="TimeWeightSlider" Minimum="0" Maximum="0.1" Value="0.01" TickFrequency="0.001" Width="160"/>
                    <TextBlock x:Name="TimeWeightDisplay" Text="0.01" Margin="10,0,0,0" Width="40"/>
                </StackPanel>

                <!-- 站点权重 -->
                <Label Grid.Row="4" Grid.Column="0" Content="站点权重:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider x:Name="StationWeightSlider" Minimum="0" Maximum="1" Value="0.1" TickFrequency="0.01" Width="160"/>
                    <TextBlock x:Name="StationWeightDisplay" Text="0.1" Margin="10,0,0,0" Width="40"/>
                </StackPanel>

                <!-- 特殊票价权重（额外增加对特殊线路的惩罚） -->
                <Label Grid.Row="5" Grid.Column="0" Content="特殊票价权重:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider x:Name="SpecialWeightSlider" Minimum="0" Maximum="10" Value="1.0" TickFrequency="0.1" Width="160"/>
                    <TextBlock x:Name="SpecialWeightDisplay" Text="1.0" Margin="10,0,0,0" Width="40"/>
                </StackPanel>
            </Grid>
        </GroupBox>
        <!-- 按钮 -->
        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="保存" Width="80" Height="30" Click="Save_Click" IsDefault="True"/>
            <Button Content="取消" Width="80" Height="30" Click="Cancel_Click" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>