<Window x:Class="MetroEditor.Windows.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入站点信息" Height="250" Width="400" Topmost="True"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Icon="/ic_launcher-playstore.png" ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="MessageTextBlock" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBox x:Name="InputTextBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="确定" Width="80" Height="30" Click="Ok_Click" IsDefault="True"/>
            <Button Content="取消" Width="80" Height="30" Click="Cancel_Click" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>