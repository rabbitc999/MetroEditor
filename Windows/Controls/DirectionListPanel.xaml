<UserControl x:Class="MetroEditor.Windows.Controls.DirectionListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 筛选行 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5" Background="#F0F0F0">
            <ComboBox x:Name="FilterColumn" Width="80" SelectedIndex="0" SelectionChanged="FilterColumn_SelectionChanged">
                <ComboBoxItem Content="方向ID" Tag="DirId"/>
                <ComboBoxItem Content="线路" Tag="DisplayLine"/>
                <ComboBoxItem Content="起点" Tag="Start"/>
                <ComboBoxItem Content="终点" Tag="End"/>
                <ComboBoxItem Content="属性" Tag="Attrs"/>
            </ComboBox>
            <TextBox x:Name="FilterTextBox" Width="150" Margin="5,0" TextChanged="FilterTextBox_TextChanged"/>
            <Button Content="清除" Click="ClearFilter_Click" Width="50"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid x:Name="dataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="DataGrid_SelectionChanged"
                  MouseDoubleClick="DataGrid_MouseDoubleClick" CanUserResizeColumns="True">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="编辑" Click="EditMenuItem_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="方向ID" Binding="{Binding DirId}" Width="80"/>
                <DataGridTextColumn Header="线路" Binding="{Binding DisplayLine}" Width="120"/>
                <DataGridTextColumn Header="起点" Binding="{Binding Start}" Width="80"/>
                <DataGridTextColumn Header="终点" Binding="{Binding End}" Width="80"/>
                <DataGridTextColumn Header="属性" Binding="{Binding Attrs}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 分割线 -->
        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#DDD"
                      ResizeBehavior="BasedOnAlignment" ResizeDirection="Rows" />

        <!-- 详情 -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <TextBlock x:Name="detailText" FontFamily="Consolas" FontSize="12"
                       TextWrapping="Wrap" Padding="5" Text="请选择一个方向查看详情" />
        </ScrollViewer>
    </Grid>
</UserControl>