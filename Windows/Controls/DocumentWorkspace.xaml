<UserControl x:Class="MetroEditor.Windows.Controls.DocumentWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MetroEditor.Windows.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.7*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="0.3*" />
        </Grid.RowDefinitions>

        <!-- TabControl（有标签时显示） -->
        <TabControl x:Name="documentTabControl" Grid.Row="0"
                    SelectionChanged="DocumentTabControl_SelectionChanged">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Content.TabHeader,
                                              RelativeSource={RelativeSource AncestorType=TabItem},
                                              FallbackValue='[无标题]'}" />
                                    <Button Content="✕" Margin="6,0,0,0" Padding="0"
                                            Background="Transparent" BorderThickness="0"
                                            Cursor="Hand" Click="CloseTabButton_Click"
                                            Tag="{Binding Content, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                </StackPanel>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.ItemContainerStyle>
        </TabControl>

        <!-- 占位提示（无标签时显示） -->
        <Border x:Name="placeholderBorder" Grid.Row="0" Background="#F5F5F5">
            <TextBlock Text="没有打开的文档" 
                       FontSize="20" 
                       Foreground="Gray" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" />
        </Border>

        <!-- 分割线 -->
        <GridSplitter x:Name="gridSplitter" Grid.Row="1" Height="5"
                      HorizontalAlignment="Stretch"
                      Background="LightGray"
                      ResizeBehavior="BasedOnAlignment" Cursor="SizeNS" />

        <!-- 错误列表 -->
        <ListBox x:Name="errorListBox" Grid.Row="2"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Background="#FFF5F5F5" FontFamily="Consolas" FontSize="12"
                 MouseDoubleClick="ErrorListBox_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Text}" Foreground="{Binding ColorBrush}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>