<UserControl x:Class="MetroEditor.Windows.Controls.SyntaxReferencePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MetroEditor.Windows.Controls"
             mc:Ignorable="d" 
             xmlns:metrolang="clr-namespace:MetroEditor.MetroLang">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBox Grid.Row="0" x:Name="SearchBox" Margin="0,0,0,4" Padding="4,2"
                 ToolTip="输入关键字搜索命令、格式或示例"
                 TextChanged="SearchBox_TextChanged" />
        <ListView Grid.Row="1" x:Name="SyntaxList"
                  MouseDoubleClick="SyntaxReferenceList_MouseDoubleClick"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="命令" Width="160" DisplayMemberBinding="{Binding Command}" />
                    <GridViewColumn Header="格式" Width="450" DisplayMemberBinding="{Binding Format}" />
                    <GridViewColumn Header="示例" Width="450" DisplayMemberBinding="{Binding Example}" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
