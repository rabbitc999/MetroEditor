<UserControl x:Class="MetroEditor.Windows.Controls.SystemInfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10">
            <!-- 程序集信息 -->
            <GroupBox Header="文件信息" Margin="0,0,0,0" Padding="10,5">
                <StackPanel>
                    <TextBlock Text="{Binding DatasetInfo, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                               FontFamily="Consolas" FontSize="16" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <!-- 默认设置 -->
            <GroupBox Header="默认设置" Margin="0,0,0,0" Padding="10,5">
                <StackPanel>
                    <TextBlock Text="{Binding DefaultSettings, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                               FontFamily="Consolas" FontSize="16" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <!-- 优惠策略 -->
            <GroupBox Header="优惠策略" Margin="0,0,0,0" Padding="10,5">
                <StackPanel>
                    <TextBlock Text="{Binding PromotionsDisplay, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                               FontFamily="Consolas" FontSize="16" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>