<UserControl x:Class="MetroEditor.Windows.Controls.MetroMapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid>
        <wv2:WebView2 x:Name="webView" />
        <!-- 可选：加载提示 -->
        <Border x:Name="loadingOverlay" Background="#F0F0F0" Visibility="Collapsed">
            <TextBlock Text="地图加载中..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
        </Border>
    </Grid>
</UserControl>