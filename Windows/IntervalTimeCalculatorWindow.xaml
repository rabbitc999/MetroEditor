<Window x:Class="MetroEditor.Windows.IntervalTimeCalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf" Topmost="True"
        Title="区间运行时间计算器" Height="750" Width="950"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 参数输入区域 -->
        <Border Grid.Row="0" BorderBrush="#ccc" BorderThickness="1" Padding="8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Label Content="编组：" VerticalAlignment="Center"/>
                <TextBox x:Name="ConsistBox" Text="6B" Width="60" Margin="5,0" ToolTip="例如 6B, 8A, 4/8A"/>

                <Label Content="功率 (kW)：" VerticalAlignment="Center" Margin="15,0,0,0"/>
                <TextBox x:Name="PowerBox" Text="2000" Width="70" Margin="5,0"/>

                <Label Content="限速 (km/h)：" VerticalAlignment="Center" Margin="15,0,0,0"/>
                <TextBox x:Name="SpeedBox" Text="80" Width="70" Margin="5,0"/>

                <Label Content="制动减速度 (m/s²)：" VerticalAlignment="Center" Margin="15,0,0,0"/>
                <TextBox x:Name="BrakeBox" Text="0.85" Width="70" Margin="5,0"/>

                <Button x:Name="CalcButton" Content="计算并绘图" Click="CalcButton_Click" Margin="20,0,0,0" Padding="10,5"/>
            </StackPanel>
        </Border>

        <!-- TabControl 展示三个图表 -->
        <TabControl Grid.Row="1" Margin="0,0,0,10">
            <TabItem Header="运行时间 vs 区间长度">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <oxy:PlotView x:Name="_PlotLengthVsTime" Grid.Row="0" />
                    <TextBlock Grid.Row="1" Margin="5" FontSize="12" Foreground="Gray"
                               Text="固定限速和功率，显示区间长度从0到对应180秒运行时间的距离。"/>
                </Grid>
            </TabItem>
            <TabItem Header="运行时间 vs 限速">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <oxy:PlotView x:Name="_PlotSpeedVsTime" Grid.Row="0" />
                    <TextBlock Grid.Row="1" Margin="5" FontSize="12" Foreground="Gray"
                               Text="固定区间长度（用户可调），显示限速与运行时间的关系。"/>
                </Grid>
            </TabItem>
            <TabItem Header="ΔT / 加速时间 vs 功率">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <oxy:PlotView x:Name="_PlotPowerVsDelta" Grid.Row="0" />
                    <TextBlock Grid.Row="1" Margin="5" FontSize="12" Foreground="Gray"
                               Text="固定限速和编组，显示功率对DeltaT和加速时间的影响。"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 结果显示区域 -->
        <Border Grid.Row="2" BorderBrush="#ccc" BorderThickness="1" Padding="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="ResultText" FontSize="14" FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>