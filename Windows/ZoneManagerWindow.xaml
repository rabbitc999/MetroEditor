<Window x:Class="MetroEditor.Windows.ZoneManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="区域管理（ZONE_DEFINE）" Height="680" Width="900" Topmost="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 区域列表 -->
        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Top">
                <Button Content="新建" Click="NewZone_Click" Width="80" Margin="0,0,0,6"/>
                <Button Content="删除" Click="DeleteZone_Click" Width="80"/>
            </StackPanel>
            <DataGrid x:Name="ZoneGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" Height="150" Margin="0,0,0,5"
                      SelectionChanged="ZoneGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="城市" Binding="{Binding City}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="颜色" Binding="{Binding Color}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="站点数" Binding="{Binding StationCount}" Width="60" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- 详情表单 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="基本信息" Grid.Column="0" Margin="0,5,3,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="ID*:" HorizontalAlignment="Right" Margin="0,2,5,2"/>
                    <TextBox x:Name="ZoneIdTextBox" Grid.Row="0" Grid.Column="1" Margin="0,2" TextChanged="Field_TextChanged"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="名称:" HorizontalAlignment="Right" Margin="0,2,5,2"/>
                    <TextBox x:Name="ZoneNameTextBox" Grid.Row="1" Grid.Column="1" Margin="0,2" TextChanged="Field_TextChanged"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="类型:" HorizontalAlignment="Right" Margin="0,2,5,2"/>
                    <TextBox x:Name="ZoneTypeTextBox" Grid.Row="2" Grid.Column="1" Margin="0,2" TextChanged="Field_TextChanged"
                             ToolTip="如 COMMERCIAL / RESIDENTIAL / CBD"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="城市:" HorizontalAlignment="Right" Margin="0,2,5,2"/>
                    <TextBox x:Name="ZoneCityTextBox" Grid.Row="3" Grid.Column="1" Margin="0,2" TextChanged="Field_TextChanged"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="颜色:" HorizontalAlignment="Right" Margin="0,2,5,2"/>
                    <TextBox x:Name="ZoneColorTextBox" Grid.Row="4" Grid.Column="1" Margin="0,2" TextChanged="Field_TextChanged"
                             ToolTip="如 #FF5722"/>

                    <Label Grid.Row="5" Grid.Column="0" Content="中心点:" HorizontalAlignment="Right" Margin="0,2,5,2"/>
                    <TextBox x:Name="ZoneCenterTextBox" Grid.Row="5" Grid.Column="1" Margin="0,2" TextChanged="Field_TextChanged"
                             ToolTip="格式：经度, 纬度"/>

                    <Label Grid.Row="6" Grid.Column="0" Content="半径(米):" HorizontalAlignment="Right" Margin="0,2,5,2"/>
                    <TextBox x:Name="ZoneRadiusTextBox" Grid.Row="6" Grid.Column="1" Margin="0,2" TextChanged="Field_TextChanged"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="几何与属性" Grid.Column="1" Margin="3,5,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="多边形:" HorizontalAlignment="Right" Margin="0,2,5,2"/>
                    <TextBox x:Name="ZonePolygonTextBox" Grid.Row="0" Grid.Column="1" Height="52" Margin="0,2"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             TextChanged="Field_TextChanged"
                             ToolTip="每行一个顶点 [经度, 纬度]，如 [113.31, 23.11]"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="站点:" HorizontalAlignment="Right" Margin="0,2,5,2"/>
                    <TextBox x:Name="ZoneStationsTextBox" Grid.Row="1" Grid.Column="1" Margin="0,2"
                             TextChanged="Field_TextChanged" ToolTip="多个站名用逗号分隔"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="高峰时段:" HorizontalAlignment="Right" Margin="0,2,5,2"/>
                    <TextBox x:Name="ZonePeakHoursTextBox" Grid.Row="2" Grid.Column="1" Margin="0,2"
                             TextChanged="Field_TextChanged" ToolTip="如 08:00-09:00, 18:00-19:00"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="人口密度:" HorizontalAlignment="Right" Margin="0,2,5,2"/>
                    <TextBox x:Name="ZoneDensityTextBox" Grid.Row="3" Grid.Column="1" Margin="0,2"
                             TextChanged="Field_TextChanged" ToolTip="万人/km²"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="平均租金:" HorizontalAlignment="Right" Margin="0,2,5,2"/>
                    <TextBox x:Name="ZoneRentTextBox" Grid.Row="4" Grid.Column="1" Margin="0,2"
                             TextChanged="Field_TextChanged" ToolTip="元/月"/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- 代码预览 -->
        <GroupBox Grid.Row="2" Header="生成的 ZONE_DEFINE 代码（预览，全部区域）" Margin="0,5">
            <TextBox x:Name="PreviewTextBox" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" IsReadOnly="True"/>
        </GroupBox>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="插入到编辑器" Click="InsertCode_Click" Width="110" Margin="0,0,10,0"/>
            <Button Content="关闭" Click="Close_Click" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
