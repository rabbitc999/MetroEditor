<Window x:Class="MetroEditor.Windows.OperatorManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="运营公司管理（OPERATOR_DEFINE）" Height="680" Width="900" Topmost="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 公司列表 -->
        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Top">
                <Button Content="新建" Click="NewOperator_Click" Width="80" Margin="0,0,0,6"/>
                <Button Content="删除" Click="DeleteOperator_Click" Width="80"/>
            </StackPanel>
            <DataGrid x:Name="OperatorGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" Height="150" Margin="0,0,0,5"
                      SelectionChanged="OperatorGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="简称" Binding="{Binding ShortName}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="城市" Binding="{Binding City}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="成立" Binding="{Binding FoundedText}" Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="线路数" Binding="{Binding LineCount}" Width="60" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- 详情表单 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="基本信息" Grid.Column="0" Margin="0,5,3,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="ID*:" HorizontalAlignment="Right" Margin="0,2,5,2"/>
                    <TextBox x:Name="OpIdTextBox" Grid.Row="0" Grid.Column="1" Margin="0,2" TextChanged="Field_TextChanged"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="名称:" HorizontalAlignment="Right" Margin="0,2,5,2"/>
                    <TextBox x:Name="OpNameTextBox" Grid.Row="1" Grid.Column="1" Margin="0,2" TextChanged="Field_TextChanged"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="简称:" HorizontalAlignment="Right" Margin="0,2,5,2"/>
                    <TextBox x:Name="OpShortNameTextBox" Grid.Row="2" Grid.Column="1" Margin="0,2" TextChanged="Field_TextChanged"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="英文名:" HorizontalAlignment="Right" Margin="0,2,5,2"/>
                    <TextBox x:Name="OpEnNameTextBox" Grid.Row="3" Grid.Column="1" Margin="0,2" TextChanged="Field_TextChanged"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="国家:" HorizontalAlignment="Right" Margin="0,2,5,2"/>
                    <TextBox x:Name="OpCountryTextBox" Grid.Row="4" Grid.Column="1" Margin="0,2" TextChanged="Field_TextChanged"/>

                    <Label Grid.Row="5" Grid.Column="0" Content="城市:" HorizontalAlignment="Right" Margin="0,2,5,2"/>
                    <TextBox x:Name="OpCityTextBox" Grid.Row="5" Grid.Column="1" Margin="0,2" TextChanged="Field_TextChanged"/>

                    <Label Grid.Row="6" Grid.Column="0" Content="成立年份:" HorizontalAlignment="Right" Margin="0,2,5,2"/>
                    <TextBox x:Name="OpFoundedTextBox" Grid.Row="6" Grid.Column="1" Margin="0,2" TextChanged="Field_TextChanged"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="联系方式与运营" Grid.Column="1" Margin="3,5,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="网站:" HorizontalAlignment="Right" Margin="0,2,5,2"/>
                    <TextBox x:Name="OpWebsiteTextBox" Grid.Row="0" Grid.Column="1" Margin="0,2" TextChanged="Field_TextChanged"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="热线:" HorizontalAlignment="Right" Margin="0,2,5,2"/>
                    <TextBox x:Name="OpHotlineTextBox" Grid.Row="1" Grid.Column="1" Margin="0,2" TextChanged="Field_TextChanged"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="简介:" HorizontalAlignment="Right" Margin="0,2,5,2"/>
                    <TextBox x:Name="OpDescriptionTextBox" Grid.Row="2" Grid.Column="1" Height="44" Margin="0,2"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             TextChanged="Field_TextChanged"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="运营线路:" HorizontalAlignment="Right" Margin="0,2,5,2"/>
                    <TextBox x:Name="OpLinesTextBox" Grid.Row="3" Grid.Column="1" Height="44" Margin="0,2"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             TextChanged="Field_TextChanged" ToolTip="线路 ID，多个用逗号或换行分隔，如 L1, L2"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="LOGO:" HorizontalAlignment="Right" Margin="0,2,5,2"/>
                    <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,2">
                        <Button Content="选择图片..." Click="SelectLogo_Click" DockPanel.Dock="Right" Width="90" Margin="6,0,0,0"/>
                        <TextBox x:Name="OpLogoTextBox" VerticalContentAlignment="Center"
                                 TextChanged="Field_TextChanged" ToolTip="LOGO 图片路径，编译时自动转为 Base64 嵌入"/>
                    </DockPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- 代码预览 -->
        <GroupBox Grid.Row="2" Header="生成的 OPERATOR_DEFINE 代码（预览，全部公司）" Margin="0,5">
            <TextBox x:Name="PreviewTextBox" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" IsReadOnly="True"/>
        </GroupBox>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="插入到编辑器" Click="InsertCode_Click" Width="110" Margin="0,0,10,0"/>
            <Button Content="关闭" Click="Close_Click" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
