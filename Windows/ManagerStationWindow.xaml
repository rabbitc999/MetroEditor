<Window x:Class="MetroEditor.Windows.ManagerStationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="站点管理" Height="600" Width="860" Topmost="True"
        WindowStartupLocation="CenterOwner" Icon="/ic_launcher-playstore.png" ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 批量添加 -->
        <GroupBox Header="批量添加（站名以空格、逗号或换行分隔）" Grid.Row="0" Margin="0,0,0,5">
            <StackPanel>
                <TextBox x:Name="BatchInputTextBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" FontSize="13"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="添加站点" Click="BatchAdd_Click" Width="100" Margin="0,0,10,0"/>
                    <Button Content="清空列表" Click="ClearAll_Click" Width="100"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- 快速筛选与批量勾选 -->
        <Grid Grid.Row="1" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <Button Content="清除" Click="ClearFilter_Click" DockPanel.Dock="Right" Width="50" Margin="6,0,0,0"/>
                <TextBlock x:Name="FilterCountText" VerticalAlignment="Center" DockPanel.Dock="Right"
                           Margin="6,0,0,0" Foreground="Gray" FontSize="11"/>
                <TextBlock Text="站名筛选:" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,6,0"/>
                <TextBox x:Name="FilterTextBox" TextChanged="FilterTextBox_TextChanged"
                         VerticalContentAlignment="Center" Padding="3,2" ToolTip="输入站名关键词，实时过滤下方列表（忽略大小写）"/>
            </DockPanel>
            <DockPanel Grid.Column="1">
                <Button Content="取消全部" Click="UncheckAll_Click" DockPanel.Dock="Right" Width="70" Margin="6,0,0,0"/>
                <Button Content="批量勾选" Click="QuickCheck_Click" DockPanel.Dock="Right" Width="70" Margin="6,0,0,0"/>
                <TextBlock Text="快速勾选:" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,6,0"
                           ToolTip="输入多行站名（空格、逗号或换行分隔），点击后自动勾选匹配的站点"/>
                <TextBox x:Name="QuickCheckTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Height="30" FontSize="12" Padding="3,2"/>
            </DockPanel>
        </Grid>

        <!-- 站点列表 -->
        <DataGrid x:Name="StationDataGrid" Grid.Row="2" AutoGenerateColumns="False" 
                  CanUserAddRows="False" CanUserDeleteRows="True"
                  ItemsSource="{Binding}" Margin="0,0,0,5"
                  CellEditEnding="StationDataGrid_CellEditEnding">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsSelected}" Width="50"/>
                <DataGridTextColumn Header="站名" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="其他语言名称" Binding="{Binding OtherNamesText, Mode=OneWay}" Width="130" IsReadOnly="True"/>
                <DataGridTextColumn Header="经度" Binding="{Binding Lon, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                <DataGridTextColumn Header="纬度" Binding="{Binding Lat, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                <DataGridTextColumn Header="城市" Binding="{Binding City, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                <DataGridTextColumn Header="校准状态" Binding="{Binding CalibrationStatus}" Width="70"/>
                <DataGridTextColumn Header="搜索结果" Binding="{Binding SearchResult, Mode=OneWay}" Width="170" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5" VerticalAlignment="Center">
            <Button Content="编辑站点" Click="EditSelected_Click" Width="90" Margin="0,0,10,0" ToolTip="编辑选中站点的名称、坐标、城市与其他语言名称"/>
            <Button Content="删除选中" Click="DeleteSelected_Click" Width="100" Margin="0,0,10,0"/>
            <Button Content="搜索预览" Click="SearchPreview_Click" Width="100" Margin="0,0,10,0"/>
            <Button Content="高德修正" Click="AmapCorrect_Click" Width="100" Margin="0,0,10,0"/>
            <Button Content="计算中心坐标" Click="CalculateCenter_Click" Width="120" Margin="0,0,10,0"/>
            <TextBlock Text="中心坐标：" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBlock x:Name="CenterCoordDisplay" Text="--" VerticalAlignment="Center" FontWeight="Bold"/>
            <ProgressBar x:Name="ProgressBar" Width="100" Height="16" Margin="10,0,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- 代码预览 -->
        <GroupBox Header="生成的 STATION_LIST 代码（预览）" Grid.Row="4" Margin="0,5,0,5">
            <TextBox x:Name="PreviewTextBox" Height="100" TextWrapping="Wrap" 
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                     IsReadOnly="False"/>
        </GroupBox>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="复制到主界面" Click="CopyCode_Click" Width="100" Margin="0,0,10,0"/>
            <Button Content="关闭" Click="Close_Click" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>