	    STATIONS ['林和西', '体育中心南', '天河南', '黄埔大道', '妇儿中心', '花城大道', '大剧院', '海心沙', '广州塔']
		DISTANCE AUTO
	END_DEFINE
  DIRECTION_DEFINE APM_1 REV APM_0
  
  SPECIAL_DEFINE
  	ALL 2
  END_DEFINE
END_DEFINE
# END_REGION

# 运营参数
OPERATION_DEFINE
  TRANSFER_TIME 120
  OUT_STATION_TRANSFER_TIME 900
  DWELL_TIME 45
  ENTRY_TIME 120
END_DEFINE

# REGION 换乘类型定义
TRANSFER_TYPE SAME "同台换乘"
    TIME 120
    STATUS OPERATING
END_DEFINE

TRANSFER_TYPE STAIR "节点换乘"
    TIME 180
    STATUS OPERATING
END_DEFINE

TRANSFER_TYPE HALL "站厅换乘"
    TIME 240
    STATUS OPERATING
END_DEFINE

TRANSFER_TYPE CHANNEL "通道换乘"
    TIME 300
    STATUS OPERATING
END_DEFINE

TRANSFER_TYPE CHANNEL_LONG "长距离通道换乘"
    TIME 600
    STATUS OPERATING
END_DEFINE

TRANSFER_TYPE CHANNEL_LONG_LONG "长长距离通道换乘"
    TIME 840
    STATUS OPERATING
END_DEFINE

TRANSFER_TYPE OUT "出站换乘"
    TIME 600
    STATUS OUT_STATION
END_DEFINE

TRANSFER_TYPE OUT_LONG "长距离出站换乘"
    TIME 900
    STATUS OUT_STATION
END_DEFINE

TRANSFER_TYPE PENDING "暂缓开通换乘"
    TIME 300
    STATUS PENDING
END_DEFINE
# END_REGION

