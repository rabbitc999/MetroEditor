PRICE_DEFINE
  DEFAULT_FARE 2.00
  SEGMENT 0.00 8.00 2.00
  SEGMENT 8.00 14.00 3.00
  SEGMENT 14.00 21.00 4.00
  SEGMENT 21.00 29.00 5.00
