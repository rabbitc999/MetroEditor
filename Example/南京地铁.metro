# 运营参数
OPERATION_DEFINE
  TRANSFER_TIME 300
  OUT_STATION_TRANSFER_TIME 600
  DWELL_TIME 45
  ENTRY_TIME 120
END_DEFINE

# 票价规则
PRICE_DEFINE
  DEFAULT_FARE 2.00
  SEGMENT 0.00 4.00 2.00
  SEGMENT 4.00 9.00 3.00
  SEGMENT 9.00 16.00 4.00
  SEGMENT 16.00 25.00 5.00
  SEGMENT 25.00 36.00 6.00
  SEGMENT 36.00 49.00 7.00
  SEGMENT 49.00 64.00 8.00
  SEGMENT 64.00 81.00 9.00
  SEGMENT 81.00 100.00 10.00
  LINEAR_EXTENSION THRESHOLD 100.00 BASE_FARE 10.00 RATE_PER_KM 0.100000
END_DEFINE

# ===== 换乘类型定义 =====
TRANSFER_TYPE SAME "同台换乘"
    TIME 60
    STATUS OPERATING
END_DEFINE

TRANSFER_TYPE STAIR "节点换乘"
    TIME 120
    STATUS OPERATING
END_DEFINE

TRANSFER_TYPE HALL "站厅换乘"
    TIME 180
    STATUS OPERATING
END_DEFINE

TRANSFER_TYPE CHANNEL "通道换乘"
    TIME 300
    STATUS OPERATING
END_DEFINE

TRANSFER_TYPE OUT "出站换乘"
    TIME 600
    STATUS OUT_STATION
END_DEFINE

# ===== 换乘定义（类型引用） =====
# 新街口（1、2）
TRANSFER STAIR "新街口" NJ1 NJ2

# 大行宫（2、3）
TRANSFER HALL "大行宫" NJ2 NJ3

