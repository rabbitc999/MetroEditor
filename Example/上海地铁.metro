# 运营参数
OPERATION_DEFINE
  TRANSFER_TIME 120
  OUT_STATION_TRANSFER_TIME 600
  DWELL_TIME 45
  ENTRY_TIME 120
END_DEFINE

# ===== 换乘类型定义 =====
TRANSFER_TYPE SAME "同台换乘"
    TIME 60
    STATUS OPERATING
END_DEFINE

TRANSFER_TYPE STAIR "节点换乘"
    TIME 120
    STATUS OPERATING
END_DEFINE

TRANSFER_TYPE HALL "站厅换乘"
    TIME 180
    STATUS OPERATING
END_DEFINE

TRANSFER_TYPE CHANNEL "通道换乘"
    TIME 300
    STATUS OPERATING
END_DEFINE

TRANSFER_TYPE OUT "出站换乘"
    TIME 600
    STATUS OUT_STATION
END_DEFINE

