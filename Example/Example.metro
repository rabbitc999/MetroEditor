# ============================================================
#  ❤️ 分手线路图 —— 情感记忆专线
#  （所有站点均已定义，可直接编译）
# ============================================================

%include '广州地铁.metro'

# 删除所有其他线路，只保留 LOVE
LINE_DELETE G*
LINE_DELETE F*
LINE_DELETE APM

# 用粉色标记这段走过的路
LINE_DEFINE LOVE
    NAME '分手线路图'
    COLOR '#FF69B4'                     # 粉色，像那时候的晚霞
    CITY '广州'
    DIRECTION_DEFINE LOVE_0
        # 按时间顺序：抵达 → 临时住处 → 常驻 → 约会 → 实习 → 上学
        STATIONS [
            '广州白云站',               # T221次火车，17小时，从合肥来到广州
            '京溪南方医院',             # 临时落脚的地方，那次买药的深夜
            '永泰',                     # 我在广州住得最久的地方
            '新市墟',                   # 和她一起开过房的地方（站厅换乘12/14）
            '棠涌',                     # 同一片区，更私密的记忆
            '神舟路',                   # 她实习的大楼附近
            '增城广场'                  # 她上学的终点站
        ]
        DISTANCE AUTO                   # 距离自动计算，实际并不重要
        NICK_NAME '记忆方向'             # 便于识别
    END_DEFINE

    # 反向方向：从她的学校回到我的起点
    DIRECTION_DEFINE LOVE_1 REV LOVE_0
END_DEFINE


# ============================================================
#  🗂️ 为关键站点添加别名（情感标签）
# ============================================================
# 注意：OTHER_NAME 必须紧随 NODE 定义之后，但原文件已定义这些站点，
# 因此我们使用 STATION_MODIFY 来追加别名（原文件未提供该块，此处仅作示意，
# 若需真正生效，需将以下内容放在原文件 STATION_DEFINE 内部或使用 STATION_MODIFY）
# 为简洁，这里改为注释记录，不影响编译

# 如果你想在数据中保留这些标签，可以手工在原 STATION_DEFINE 中对应 NODE 下方添加：
#   OTHER_NAME ['爱开始的地方', '永泰']
#   OTHER_NAME ['临时港湾', '京溪南方医院']
#   OTHER_NAME ['深夜买药', '京溪南方医院']
#   OTHER_NAME ['两小时约会', '新市墟']
#   OTHER_NAME ['她的工位', '神舟路']
#   OTHER_NAME ['校园终点', '增城广场']


# ============================================================
#  💬 编译时输出情感独白
# ============================================================
ECHO ""
ECHO "【分手线路图】编译完成"
ECHO "========================"
ECHO "两年前，可话相识；100天前，恋爱"
ECHO "为了不异地，我从合肥坐了17小时火车到广州白云站"
ECHO "住过永泰，躺过京溪南方医院，在棠涌/新市墟看过深夜的街道"
ECHO "她实习在神舟路，上学在增城广场"
ECHO "广州地铁的拥挤度（CROWD）我曾用代码记录"
ECHO "却记录不了人心的温度"
ECHO ""
ECHO "广州火车站那些暂缓开通的线路（PENDING）"
ECHO "像极了我们说过的未来"
ECHO "真正运行的，只有2号线和5号线"
ECHO "就像我们真正拥有的，只有这段一起走过的日子"
ECHO ""
ECHO "现在到站了，我下车了"
ECHO "分手不遗憾，毕竟曾经准时发车过"
ECHO "百年官桥，千年洪圣沙，万年广火"
ECHO "========================"

# 额外：给广州火车站的状态注解（原文件已有 PENDING，这里仅做情感呼应）
# STATION_STATUS '广州火车站' G14 PENDING  # 已存在
# STATION_STATUS '广州火车站' G11 PENDING  # 已存在