# 主城市定义
PROGRAM_DEFINE
    KEY_CITY '广州'
    OTHER_CITY ['佛山', '中山']
    VERSION 'V1.0'
    UPDATE_DATE '2026-7-11'
END_DEFINE

# 车站列表
STATION_DEFINE
  NODE "广州东站" COORD 113.332, 23.156 CITY "广州"
  NODE "体育中心" COORD 113.328, 23.142 CITY "广州"
  NODE "西塱" COORD 113.233, 23.082 CITY "广州"
END_DEFINE

# 线路定义
LINE_DEFINE GZ1
  NAME '1号线'
  COLOR '#F47920'
  OPEN_YEAR 2000
  SPECIAL
  DIRECTION_DEFINE GZ1_0
    STATIONS ['广州东站', '体育中心', '西塱']
    DISTANCE [2.083711, 11.787928, NIL]
    VIA GZ1_1
  END_DEFINE
  DIRECTION_DEFINE GZ1_1 REV GZ1_0
  POWER 1100
END_DEFINE

# 运营参数
OPERATION_DEFINE
  TRANSFER_TIME 180
  OUT_STATION_TRANSFER_TIME 300
  STOP_TIME 30
  ENTRY_TIME 120
END_DEFINE

# 自定义停站时间
STOP_TIME '体育中心' GZ1 30.00
STOP_TIME '体育中心' GZ1 30.00
STOP_TIME '西塱' GZ1 36.00
STOP_TIME '西塱' GZ1 36.00

# 票价规则
PRICE_DEFINE
  DEFAULT_FARE 2.00
  SEGMENT 0.00 6.00 2.00
  SEGMENT 6.00 12.00 3.00
  LINEAR_EXTENSION THRESHOLD 12.00 BASE_FARE 3.00 RATE_PER_KM 0.200000
  SPECIAL_LINE GZ1 ALL 25.00
END_DEFINE

# 发车间隔
HEADWAY_PROFILE GZ1
   PERIOD TIME_RANGE 07:00 09:00 VALUE 120
END_DEFINE

# 站点进出模式
STATION_MODE '体育中心' ENTRY_ONLY TIME_RANGE 07:30 09:00 WORKDAY

# 拥挤度系数
CROWD_PROFILE GZ1_0
  PERIOD 07:00 09:00 1.50 WORKDAY
END_DEFINE

# 运营时间
OPEN_TIME GLOBAL 06:00 23:00
OPEN_TIME GZ1 06:30 22:30 WEEKEND

# 车辆段
DEPOT GZ1 '西塱' GZ1_0 06:00

# 区间限速
SPEED_LIMIT_DEFINE GZ1_0
  NODE '广州东站' '体育中心' 70
  NODE '体育中心' '西塱' 60
END_DEFINE
