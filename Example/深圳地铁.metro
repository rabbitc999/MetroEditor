# 运营参数
OPERATION_DEFINE
  TRANSFER_TIME 300
  OUT_STATION_TRANSFER_TIME 600
  DWELL_TIME 45
  ENTRY_TIME 120
END_DEFINE

# 自定义换乘
TRANSFER_DEFINE '福田口岸' SZ4 SZ10
  STATUS OUT_STATION
  TIME 600
END_DEFINE
TRANSFER_DEFINE '湖贝' SZ5 SZ2_8
  STATUS OUT_STATION
  TIME 600
END_DEFINE
TRANSFER_DEFINE '红岭南' SZ9 SZ11
  STATUS OUT_STATION
  TIME 600
END_DEFINE

# ===== 换乘类型定义 =====
TRANSFER_TYPE SAME "同台换乘"
    TIME 60
    STATUS OPERATING
END_DEFINE

TRANSFER_TYPE STAIR "节点换乘"
    TIME 120
    STATUS OPERATING
END_DEFINE

TRANSFER_TYPE HALL "站厅换乘"
    TIME 180
    STATUS OPERATING
END_DEFINE

TRANSFER_TYPE CHANNEL "通道换乘"
    TIME 300
    STATUS OPERATING
END_DEFINE

TRANSFER_TYPE OUT "出站换乘"
    TIME 600
    STATUS OUT_STATION
END_DEFINE

# ===== 换乘定义（类型引用） =====
