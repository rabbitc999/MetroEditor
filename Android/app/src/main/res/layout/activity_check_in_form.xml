<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:ignore="HardcodedText"
    android:padding="16dp">

    <!-- 表单区收集日期、备注、随笔和待提交的多张图片。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="8dp"
        tools:ignore="HardcodedText">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_card">

            <LinearLayout
                android:id="@+id/selectionPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">
                <Button
                    android:id="@+id/btnBack"
                    style="@style/BackButton"
                    android:text="← 返回" />

                <TextView
                    android:layout_width="0sp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="📍 新增打卡"
                    android:textSize="20sp"
                    android:textColor="#1A73E8"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_card">
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvStation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        tools:text="体育西路站（广州）" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="📅 打卡日期（点击修改）"
                        android:textSize="13sp"
                        android:textColor="#666666" />

                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="16sp"
                        android:textColor="#1565C0"
                        tools:text="2026-08-23" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="📝 备注"
                        android:textSize="13sp"
                        android:textColor="#666666" />

                    <EditText
                        android:id="@+id/etNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="2"
                        android:hint="填写打卡备注"
                        android:textSize="14sp" />


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="📝 小作文"
                        android:textSize="13sp"
                        android:textColor="#666666" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <Button android:id="@+id/btnBold" style="@style/ModeButton" android:layout_weight="1" android:layout_width="0sp" android:layout_height="36dp" android:text="加粗" android:textSize="12sp" />
                        <Button android:id="@+id/btnItalic" style="@style/ModeButton" android:layout_weight="1" android:layout_width="0sp" android:layout_height="36dp" android:text="斜体" android:textSize="12sp" />
                        <Button android:id="@+id/btnHeading" style="@style/ModeButton" android:layout_weight="1" android:layout_width="0sp" android:layout_height="36dp" android:text="标题" android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp"
                        android:padding="12dp"
                        android:background="@drawable/bg_rounded_card">
                        <EditText
                            android:id="@+id/etEssay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="写点小作文，支持加粗、斜体、标题等 HTML"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="🖼 照片"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#333333" />


                    <LinearLayout
                        android:id="@+id/imageListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnAddImages"
                            style="@style/ModeButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="添加多图"
                            android:textSize="13sp"
                            android:backgroundTint="#1A73E8" />

                        <Button
                            android:id="@+id/btnTakePhoto"
                            style="@style/ModeButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="拍照"
                            android:textSize="13sp"
                            android:backgroundTint="#34A853" />

                        <Button
                            android:id="@+id/btnClearImages"
                            style="@style/ModeButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="清空图片"
                            android:textSize="13sp"
                            android:backgroundTint="#E24B4A" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnSave"
                        style="@style/ModeButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:text="保存修改"
                        android:textSize="15sp"
                        android:backgroundTint="#FF7043" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
