<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_rounded_card"
    tools:ignore="HardcodedText">

    <!-- 第一行：路线 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvRoute"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#333333"
            tools:text="体育西路 → 广州东站" />

        <Button
            android:id="@+id/btnDelete"
            style="@style/ModeButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="48dp"
            android:text="删除"
            android:textSize="12sp"
            android:backgroundTint="#E24B4A" />

    </LinearLayout>

    <!-- 第二行：时间与模式 -->
    <TextView
        android:id="@+id/tvTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:textColor="#888888"
        tools:text="2026-08-22 14:30 · 最短时间" />

    <!-- 第三行：统计信息 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDistance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#5A73E8"
            android:background="#EEF1FB"
            android:padding="6dp"
            android:gravity="center"
            tools:text="12.5 公里" />

        <TextView
            android:id="@+id/tvTime2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:textSize="13sp"
            android:textColor="#2E8B57"
            android:background="#EAF6F0"
            android:padding="6dp"
            android:gravity="center"
            tools:text="28 分钟" />

        <TextView
            android:id="@+id/tvTransfers"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:textSize="13sp"
            android:textColor="#B8860B"
            android:background="#FBF5E6"
            android:padding="6dp"
            android:gravity="center"
            tools:text="1 次换乘" />

        <TextView
            android:id="@+id/tvFare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:textSize="13sp"
            android:textColor="#E24B4A"
            android:background="#FBECEC"
            android:padding="6dp"
            android:gravity="center"
            tools:text="¥5" />

    </LinearLayout>

</LinearLayout>
