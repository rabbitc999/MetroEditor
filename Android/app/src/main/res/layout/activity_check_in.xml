<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:ignore="HardcodedText"
    android:padding="16dp">

    <!-- 列表页顶部为操作栏，下方动态填充历史打卡记录。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="8dp"
        tools:ignore="HardcodedText">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:padding="12dp"
        android:background="@drawable/bg_rounded_card">

        <LinearLayout
            android:id="@+id/selectionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <Button
                android:id="@+id/btnBack"
                style="@style/BackButton"
                android:text="← 返回" />

            <TextView
                android:layout_width="0sp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="📍 站点打卡"
                android:textSize="20sp"
                android:textColor="#1A73E8"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <Button
                android:id="@+id/btnPlan"
                style="@style/BackButton"
                android:layout_width="0sp"
                android:layout_weight="1"
                android:text="任务链" />

            <Button
                android:id="@+id/btnClearAll"
                style="@style/BackButton"
                android:layout_width="0sp"
                android:layout_weight="1"
                android:text="清空" />

            <Button
                android:id="@+id/btnAdd"
                style="@style/BackButton"
                android:layout_width="0sp"
                android:layout_weight="1"
                android:text="新增" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:padding="12dp"
                android:background="@drawable/bg_rounded_card">

                <TextView
                    android:id="@+id/tvRecordTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📋 打卡记录"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <TextView
                    android:id="@+id/tvCurrentCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="🏙️ 当前城市："
                    android:textSize="13sp"
                    android:textColor="#1565C0" />

                <AutoCompleteTextView
                    android:id="@+id/searchInput"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:hint="按站名查询打卡记录"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1" />

                <LinearLayout
                    android:id="@+id/recordContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvEmptyRecord"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="暂无打卡记录\n点击右上角「＋ 新增」进行打卡"
                    android:textSize="13sp"
                    android:textColor="#999999"
                    android:gravity="center"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
</LinearLayout>
