<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:layout_marginBottom="6dp"
    android:background="#F0F4F8"
    tools:ignore="HardcodedText">

    <!-- 打卡图片缩略图（无图时隐藏） -->
    <ImageView
        android:id="@+id/ivCheckInImage"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:scaleType="centerCrop"
        android:contentDescription="打卡图片"
        android:visibility="gone"
        tools:src="@android:drawable/ic_menu_gallery"
        tools:visibility="visible" />

    <!-- 站点与时间信息 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCheckInCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#1565C0"
            android:textStyle="bold"
            tools:text="🏙️ 广州" />

        <TextView
            android:id="@+id/tvStationName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#333333"
            tools:text="体育西路站" />

        <TextView
            android:id="@+id/tvCheckInTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="#888888"
            tools:text="2026-08-22 14:30:25" />

        <!-- 打卡日期（与打卡时间不同时显示） -->
        <TextView
            android:id="@+id/tvCheckInDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="#C77C02"
            android:visibility="gone"
            tools:text="📅 2026-08-20"
            tools:visibility="visible" />

        <!-- 备注 -->
        <TextView
            android:id="@+id/tvCheckInNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="#666666"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone"
            tools:text="📝 第一次来这个站"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- 站点与时间信息 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical">
        <!-- 修改按钮 -->
        <Button
            android:id="@+id/btnEdit"
            style="@style/ModeButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="48dp"
            android:text="修改"
            android:textSize="12sp"
            android:backgroundTint="#1A73E8" />

        <!-- 删除按钮 -->
        <Button
            android:id="@+id/btnDelete"
            style="@style/ModeButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="48dp"
            android:text="删除"
            android:textSize="12sp"
            android:backgroundTint="#E24B4A" />

    </LinearLayout>
</LinearLayout>
