<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:padding="16dp"
    tools:ignore="HardcodedText,Autofill,LabelFor,ButtonStyle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="8dp"
        tools:ignore="HardcodedText">
        <!-- ================= 顶部选择面板（卡片） ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_rounded_card">
            <com.rabbitc.subway.widget.StartEndBar
                android:id="@+id/startEndBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:startText="体育西路"
                app:endText="广州东站"
                app:hintText="选择线路或设置路线显示全站名，也可点击按钮完成指定路线绘制"
                app:showBackButton="true"
                app:showHint="true" />
        </LinearLayout>

        <!-- ================= 地图卡片 ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- 地图标题栏 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🗺️ 地图信息（长按选点）"
                        android:textColor="#1A73E8"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/clearBtn"
                        style="@style/ResetButton"
                        android:text="重置路线" />
                </LinearLayout>

                <!-- 地图视图 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="4dp">
                    <com.rabbitc.subway.view.SubwayMapView
                        android:id="@+id/subwayMapView"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:background="@drawable/bg_rounded_card"
                        android:padding="3dp"
                        android:layout_marginBottom="12dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ================= 图例卡片 ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_card">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📋 线路图例（长按图例详情）"
                android:layout_marginBottom="8dp"
                android:textColor="#1A73E8"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.rabbitc.subway.widget.LegendListView
                    android:id="@+id/legendListView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>