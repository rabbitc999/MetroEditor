<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"    xmlns:app="http://schemas.android.com/apk/res-auto"    xmlns:tools="http://schemas.android.com/tools"    android:layout_width="match_parent"    android:layout_height="match_parent"    android:orientation="vertical"    android:background="#F5F7FA"    android:padding="16dp"    android:fitsSystemWindows="true"    tools:ignore="HardcodedText">    <LinearLayout        android:layout_width="match_parent"        android:orientation="vertical"        android:layout_height="0dp"        android:layout_weight="1"        android:padding="8dp"        tools:ignore="HardcodedText">        <!-- ================= 标题 ================= -->        <LinearLayout            android:layout_width="match_parent"            android:layout_height="wrap_content"            android:orientation="vertical"            android:background="@drawable/bg_rounded_card">            <LinearLayout                android:id="@+id/selectionPanel"                android:layout_width="match_parent"                android:layout_height="wrap_content"                android:orientation="horizontal"                android:padding="12dp"                android:gravity="center_vertical">                <Button                    android:id="@+id/backToMainBtn"                    style="@style/BackButton"                    android:text="← 返回" />                <TextView                    android:layout_width="match_parent"                    android:layout_height="wrap_content"                    android:gravity="center"                    android:text="😂 通勤距离批量计算"                    android:textSize="20sp"                    android:textColor="#1A73E8"                    android:textStyle="bold" />            </LinearLayout>        </LinearLayout>        <!-- ================= 参数设置卡片 ================= -->        <LinearLayout            android:layout_width="match_parent"            android:layout_height="wrap_content"            android:orientation="vertical"            android:layout_marginTop="12dp"            android:background="@drawable/bg_rounded_card">            <LinearLayout                android:layout_width="match_parent"                android:layout_height="wrap_content"                android:orientation="vertical"                android:padding="16dp">                <TextView                    android:layout_width="match_parent"                    android:layout_height="wrap_content"                    android:layout_marginBottom="8dp"                    android:text="⚙️ 计算参数"                    android:textColor="#1A73E8"                    android:textSize="18sp"                    android:textStyle="bold" />                <LinearLayout                    android:layout_width="match_parent"                    android:layout_height="wrap_content"                    android:orientation="horizontal"                    android:gravity="center_vertical">                    <AutoCompleteTextView                        android:id="@+id/commuteStartInput"                        android:layout_width="0dp"                        android:layout_height="wrap_content"                        android:layout_weight="1"                        android:enabled="false"                        android:hint="输入起点站"                        android:padding="10dp"                        android:background="@drawable/input_bg" />                    <Button                        android:id="@+id/commuteBatchBtn"                        style="@style/ActionButton"                        android:layout_marginStart="8dp"                        android:text="批量计算"                        android:enabled="false"                        android:backgroundTint="#2E7D32" />                </LinearLayout>                <!-- 状态提示 -->                <TextView                    android:id="@+id/commuteStatus"                    android:layout_width="match_parent"                    android:layout_height="wrap_content"                    android:layout_marginTop="8dp"                    android:padding="8dp"                    android:background="@drawable/bg_route_content"                    android:text="尚未计算"                    android:textColor="#666"                    android:textSize="14sp"                    android:maxLines="1"                    android:ellipsize="end" />            </LinearLayout>        </LinearLayout>        <!-- ================= 结果列表卡片 ================= -->        <LinearLayout            android:layout_width="match_parent"            android:layout_height="0px"            android:layout_weight="1"            android:orientation="vertical"            android:layout_marginTop="12dp"            android:background="@drawable/bg_rounded_card">            <LinearLayout                android:layout_width="match_parent"                android:layout_height="match_parent"                android:orientation="vertical"                android:padding="12dp">                <TextView                    android:layout_width="match_parent"                    android:layout_height="wrap_content"                    android:layout_marginBottom="8dp"                    android:text="📊 计算结果"                    android:textColor="#1A73E8"                    android:textSize="18sp"                    android:textStyle="bold" />                <!-- 表头 -->                <LinearLayout                    android:layout_width="match_parent"                    android:layout_height="wrap_content"                    android:background="#1A73E8"                    android:padding="10dp"                    android:orientation="horizontal"                    android:weightSum="5">                    <TextView                        android:layout_width="0dp"                        android:layout_height="wrap_content"                        android:layout_weight="0.6"                        android:text="序号"                        android:textColor="#FFFFFF"                        android:textSize="13sp"                        android:textStyle="bold"                        android:gravity="start" />                    <TextView                        android:layout_width="0dp"                        android:layout_height="wrap_content"                        android:layout_weight="1.4"                        android:text="站点"                        android:textColor="#FFFFFF"                        android:textSize="13sp"                        android:textStyle="bold"                        android:gravity="start"                        android:paddingStart="4dp" />                    <TextView                        android:layout_width="0dp"                        android:layout_height="wrap_content"                        android:layout_weight="1"                        android:text="距离(km)"                        android:textColor="#FFFFFF"                        android:textSize="13sp"                        android:textStyle="bold"                        android:gravity="center"                        android:paddingEnd="4dp" />                    <TextView                        android:layout_width="0dp"                        android:layout_height="wrap_content"                        android:layout_weight="1"                        android:text="时间(分)"                        android:textColor="#FFFFFF"                        android:textSize="13sp"                        android:textStyle="bold"                        android:gravity="center"                        android:paddingEnd="4dp" />                    <TextView                        android:layout_width="0dp"                        android:layout_height="wrap_content"                        android:layout_weight="1.2"                        android:text="路费(元)"                        android:textColor="#FFFFFF"                        android:textSize="13sp"                        android:textStyle="bold"                        android:gravity="center"                        android:paddingEnd="4dp" />                </LinearLayout>                <!-- 列表 -->                <ListView                    android:id="@+id/commuteListView"                    android:layout_width="match_parent"                    android:layout_height="0dp"                    android:layout_weight="1"                    android:layout_marginTop="0dp"                    android:layout_marginEnd="12dp"                    android:background="#FFFFFF"                    android:divider="#E8ECF0"                    android:dividerHeight="1dp" />            </LinearLayout>        </LinearLayout>        <!-- ================= 底部操作栏 ================= -->        <LinearLayout            android:layout_width="match_parent"            android:layout_height="wrap_content"            android:orientation="vertical"            android:layout_marginTop="12dp"            android:background="@drawable/bg_rounded_card">            <LinearLayout                android:layout_width="match_parent"                android:layout_height="wrap_content"                android:orientation="horizontal"                android:padding="12dp"                android:gravity="center_vertical">                <Button                    android:id="@+id/exportCsvBtn"                    style="@style/ActionButton"                    android:text="⬇ 导出 CSV"                    android:enabled="false"                    android:backgroundTint="#455A64" />                <TextView                    android:id="@+id/csvCount"                    android:layout_width="0dp"                    android:layout_height="wrap_content"                    android:layout_weight="1"                    android:gravity="end"                    android:text=""                    android:textColor="#999"                    android:textSize="14sp" />            </LinearLayout>        </LinearLayout>    </LinearLayout></LinearLayout>