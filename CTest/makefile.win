# Project: MetroSign
# Makefile created by Red Panda C++ 3.1.2871

CXX      = "g++.exe"
CC       = "gcc.exe"
WINDRES  = "windres.exe"
RM       = del /q /f
CD       = cd /d
LIBS     = "-m64" "-Wl,--stack,12582912"
INCS     = 
CXXINCS  = 
CXXFLAGS = $(CXXINCS) "-g3" "-std=c++2b" "-pipe" "-static" "-D_DEBUG"
CFLAGS   = $(INCS) "-std=gnu17" "-g3" "-pipe" "-static" "-D_DEBUG"
WINDRESFLAGS = 
RES      = MetroSign_private.res
OBJ      = test.o metro.o $(RES)
BIN      = MetroSign.exe
LINKOBJ  = "test.o" "metro.o" "MetroSign_private.res"
CLEANOBJ = "test.o" "metro.o" "MetroSign_private.res" "MetroSign.exe"

.PHONY: all all-before all-after clean clean-custom

all: all-before $(BIN) all-after

clean: clean-custom
	-$(RM) $(CLEANOBJ) >NUL 2>&1

MetroSign.exe: $(OBJ)

	$(CXX) $(LINKOBJ) -o "MetroSign.exe" $(LIBS)

test.o: test.c metro.h
	$(CC) -c "test.c" -o "test.o" $(CFLAGS)  -finput-charset=UTF-8 -fexec-charset=gbk

metro.o: metro.c uthash.h metro.h
	$(CC) -c "metro.c" -o "metro.o" $(CFLAGS)  -finput-charset=UTF-8 -fexec-charset=gbk

MetroSign_private.res: MetroSign_private.rc 
	$(WINDRES) -i "MetroSign_private.rc" --input-format=rc -o "MetroSign_private.res" -O coff $(WINDRESFLAGS) 

